PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
NODE_ENV=development
# Set only behind a trusted reverse proxy, usually 1. Leave empty for direct access.
TRUST_PROXY_HOPS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clicksurvey
DB_USER=clicksurvey_user
DB_PASSWORD=secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=smtp-user
SMTP_PASS=smtp-pass
EMAIL_FROM="ClickSurvey" <noreply@clicksurvey.com.au>
BASE_URL=http://localhost:3000
# Provision explicitly with npm run admin:create; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
