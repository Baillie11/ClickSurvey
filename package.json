{
  "name": "clicksurvey",
  "version": "0.1.0",
  "description": "Event-triggered survey platform for automated survey invitations.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "worker": "node src/worker.js",
    "db:migrate": "node scripts/migrate.js",
    "admin:create": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 test",
    "db:backup": "node scripts/backup.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.2"
  },
  "devDependencies": {
    "parse5": "^7.3.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20.20.0"
  }
}
