<div class="card p-4">
  <h1><%= invite.source_app %> Survey</h1>
  <p class="text-muted">Hi <%= invite.recipient_name || invite.recipient_email %>, we’d appreciate your feedback.</p>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <form method="post" action="<%= appPath %>/r/<%= invite.invite_token %>" data-survey-logic>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <% questions.forEach(question => { %>
      <div class="mb-3" data-question-id="<%= question.id %>" data-condition-question-id="<%= question.condition_question_id || '' %>" data-condition-value="<%= question.condition_value || '' %>" <%= question.condition_question_id ? 'hidden' : '' %>>
        <label class="form-label"><%= question.question_text %><%= question.required ? ' *' : '' %></label>
        <% if (question.question_type === 'short_text') { %>
          <input type="text" name="question_<%= question.id %>" class="form-control" />
        <% } else if (question.question_type === 'long_text') { %>
          <textarea name="question_<%= question.id %>" class="form-control" rows="3"></textarea>
        <% } else if (question.question_type === 'email') { %>
          <input type="email" name="question_<%= question.id %>" class="form-control" />
        <% } else if (question.question_type === 'number') { %>
          <input type="number" name="question_<%= question.id %>" class="form-control" />
        <% } else if (question.question_type === 'dropdown') { %>
          <select name="question_<%= question.id %>" class="form-select"><option value="">Choose...</option><% JSON.parse(question.options_json || '[]').forEach(opt => { %><option value="<%= opt %>"><%= opt %></option><% }) %></select>
        <% } else if (question.question_type === 'multiple_choice') { %>
          <% JSON.parse(question.options_json || '[]').forEach(opt => { %><div class="form-check"><input class="form-check-input" type="radio" name="question_<%= question.id %>" value="<%= opt %>" /><label class="form-check-label"><%= opt %></label></div><% }) %>
        <% } else if (question.question_type === 'checkboxes') { %>
          <% JSON.parse(question.options_json || '[]').forEach(opt => { %><div class="form-check"><input class="form-check-input" type="checkbox" name="question_<%= question.id %>" value="<%= opt %>" /><label class="form-check-label"><%= opt %></label></div><% }) %>
        <% } else if (question.question_type === 'star_rating') { %>
          <select name="question_<%= question.id %>" class="form-select"><option value="">Choose...</option><% for (let i = 1; i <= 5; i++) { %><option value="<%= i %>"><%= i %> star<%= i > 1 ? 's' : '' %></option><% } %></select>
        <% } else if (question.question_type === 'rating_1_10') { %>
          <select name="question_<%= question.id %>" class="form-select"><option value="">Choose...</option><% for (let i = 1; i <= 10; i++) { %><option value="<%= i %>"><%= i %></option><% } %></select>
        <% } else if (question.question_type === 'yes_no') { %>
          <select name="question_<%= question.id %>" class="form-select"><option value="">Choose...</option><option value="Yes">Yes</option><option value="No">No</option></select>
        <% } else if (question.question_type === 'name') { %>
          <input type="text" name="question_<%= question.id %>" class="form-control" />
        <% } else { %>
          <input type="text" name="question_<%= question.id %>" class="form-control" />
        <% } %>
      </div>
    <% }) %>
    <button class="btn btn-primary">Submit Feedback</button>
  </form>
  <% if (questions.some(q => q.condition_question_id)) { %><noscript><p>Please enable JavaScript to see the follow-up questions for your answers.</p></noscript><% } %>
  <script src="<%= appPath %>/question-logic.js" defer></script>
  <script src="<%= appPath %>/survey-logic.js" defer></script>
  <footer class="mt-4 text-muted"><%= invite.footer_text || '' %></footer>
</div>
