<h1>Responses</h1>
<div class="table-responsive mt-3">
  <table class="table table-hover">
    <thead><tr><th>ID</th><th>Survey</th><th>Recipient</th><th>Source</th><th>Event</th><th>Submitted</th></tr></thead>
    <tbody>
      <% responses.forEach(r => { %>
        <tr>
          <td><a href="<%= appPath %>/admin/responses/<%= r.id %>"><%= r.id %></a></td>
          <td><%= r.survey_title %></td>
          <td><%= r.recipient_name || r.recipient_email || 'Guest' %></td>
          <td><%= r.source_app || 'N/A' %></td>
          <td><%= r.event_type || 'N/A' %></td>
          <td><%= new Date(r.submitted_at).toLocaleString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
