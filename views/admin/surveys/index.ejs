<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Surveys</h1>
  <a class="btn btn-primary" href="<%= appPath %>/admin/surveys/new">New Survey</a>
</div>
<p>Use <strong>Preview blank survey</strong> to view the questions and try conditional answers without saving a response.</p>
<% if (typeof status !== 'undefined' && status) { %><p>Showing Active surveys. <a href="<%= appPath %>/admin/surveys">Show all surveys</a></p><% } %>
<div class="table-responsive">
  <table class="table table-hover">
    <thead><tr><th>ID</th><th>Title</th><th>Key</th><th>Status</th><th>Updated</th><th>Actions</th></tr></thead>
    <tbody>
      <% surveys.forEach(survey => { %>
        <tr>
          <td><%= survey.id %></td>
          <td><%= survey.title %></td>
          <td><%= survey.survey_key %></td>
          <td><%= survey.status %></td>
          <td><%= new Date(survey.updated_at).toLocaleDateString() %></td>
          <td>
            <a class="btn btn-sm btn-outline-primary" href="<%= appPath %>/admin/surveys/<%= survey.id %>/preview">Preview blank survey</a>
            <a class="btn btn-sm btn-outline-secondary" href="<%= appPath %>/admin/surveys/<%= survey.id %>/edit">Edit</a>
            <a class="btn btn-sm btn-outline-secondary" href="<%= appPath %>/admin/surveys/<%= survey.id %>/questions">Questions</a>
            <a class="btn btn-sm btn-outline-secondary" href="<%= appPath %>/admin/surveys/<%= survey.id %>/responses/csv">Export CSV</a>
            <% if(survey.status === 'Active') { %><a class="btn btn-sm btn-outline-primary" href="<%= appPath %>/s/<%= survey.survey_key %>">Open survey</a><% } %>
            <form class="d-inline" method="post" action="<%= appPath %>/admin/surveys/<%= survey.id %>/delete">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="btn btn-sm btn-danger">Archive</button></form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
