<div class="card p-4">
  <h1>Edit Survey</h1>
  <p class="text-muted">Update your survey configuration and branding. Changes apply immediately to active surveys.</p>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <form method="post" action="<%= appPath %>/admin/surveys/<%= survey.id %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="mb-3">
      <label class="form-label">Survey Key <span class="text-danger">*</span></label>
      <input name="survey_key" class="form-control" value="<%= survey.survey_key %>" required />
      <small class="form-text text-muted">Changing this key changes the public survey URL.</small>
    </div>
    <div class="mb-3">
      <label class="form-label">Title <span class="text-danger">*</span></label>
      <input name="title" class="form-control" value="<%= survey.title %>" required />
      <small class="form-text text-muted">Display name shown in your dashboard and to respondents.</small>
    </div>
    <div class="mb-3">
      <label class="form-label">Description</label>
      <textarea name="description" class="form-control" rows="3"><%= survey.description %></textarea>
      <small class="form-text text-muted">Optional introduction shown on the public survey page.</small>
    </div>
    <div class="mb-3">
      <label class="form-label">Thank You Message</label>
      <textarea name="thank_you_message" class="form-control" rows="2"><%= survey.thank_you_message %></textarea>
      <small class="form-text text-muted">Message displayed to respondents after they submit the survey.</small>
    </div>
    <div class="mb-3">
      <label class="form-label">Status</label>
      <select name="status" class="form-select">
        <option value="Draft" <%= survey.status === 'Draft' ? 'selected' : '' %>>Draft</option>
        <option value="Active" <%= survey.status === 'Active' ? 'selected' : '' %>>Active</option>
        <option value="Archived" <%= survey.status === 'Archived' ? 'selected' : '' %>>Archived</option>
      </select>
      <small class="form-text text-muted"><strong>Draft:</strong> Not yet live. <strong>Active:</strong> Ready to receive responses. <strong>Archived:</strong> Hidden from active list.</small>
    </div>
    <hr />
    <h5>Invitation email</h5>
    <div class="mb-3">
      <label for="email_sender_name" class="form-label">Sender name</label>
      <input id="email_sender_name" name="email_sender_name" class="form-control" maxlength="255" placeholder="e.g., Your Company Name" value="<%= survey.email_sender_name || '' %>" />
      <small class="form-text text-muted">The name recipients see in their inbox. Leave blank to use your Brand Name, or the default sender if no brand is set. The sending email address stays the same.</small>
    </div>
    <div class="mb-3">
      <label for="email_subject" class="form-label">Email subject</label>
      <input id="email_subject" name="email_subject" class="form-control" maxlength="255" placeholder="e.g., How was your experience with Your Company?" value="<%= survey.email_subject || '' %>" />
      <small class="form-text text-muted">Used exactly as entered for future invitations. Leave blank to use: Quick feedback about your [source app] experience.</small>
    </div>
    <hr />
    <h5>Branding</h5>
    <div class="mb-3">
      <label class="form-label">Brand Name</label>
      <input name="brand_name" class="form-control" value="<%= survey.brand_name %>" />
      <small class="form-text text-muted">Displayed at the top of the survey page.</small>
    </div>
    <div class="mb-3">
      <label class="form-label">Logo URL</label>
      <input name="logo_url" class="form-control" value="<%= survey.logo_url %>" />
      <small class="form-text text-muted">Full URL to your company logo (must be publicly accessible).</small>
    </div>
    <div class="mb-3">
      <label class="form-label">Primary Colour</label>
      <input name="primary_colour" type="color" class="form-control form-control-color" value="<%= survey.primary_colour || '#0d6efd' %>" />
      <small class="form-text text-muted">Main accent colour for buttons and headings.</small>
    </div>
    <div class="mb-3">
      <label class="form-label">Footer Text</label>
      <input name="footer_text" class="form-control" value="<%= survey.footer_text %>" />
      <small class="form-text text-muted">Text displayed at the bottom of the survey page.</small>
    </div>
    <button class="btn btn-primary">Save Changes</button>
  </form>
</div>
